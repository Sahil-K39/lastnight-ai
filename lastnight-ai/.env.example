# AI_PROVIDER controls the backend-only model provider.
# Use "gemini" for deployed cloud demos and "ollama" for local privacy-first mode.
AI_PROVIDER="gemini"

# Cloud demo mode: Gemini Flash free tier.
# Get a key from Google AI Studio and keep it only in backend env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Local AI mode: Ollama running on your machine.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Optional: require this secret on API requests when you deploy behind a trusted server.
# Leave empty for local browser demos.
APP_SHARED_SECRET=""

# Optional server/network tuning.
PORT=3000
HOST="127.0.0.1"
REQUEST_JSON_LIMIT="35mb"
API_RATE_LIMIT_MAX=30

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
